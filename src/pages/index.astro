---
import BaseLayout from '../layouts/BaseLayout.astro';
import settings from '../data/settings.json';
import { extractYoutubeId, youtubeEmbedUrl } from '../lib/youtube';

type Button = { label: string; url: string; newTab?: boolean };
const s = settings as typeof settings & {
  featuredYoutubeId?: string;
  buttons?: Button[];
  social?: { instagram?: string; youtube?: string; stickers?: string };
};
// New list format; falls back to the legacy fixed "social" fields.
const buttons: Button[] = (
  s.buttons ??
  [
    { label: 'Instagram', url: s.social?.instagram ?? '' },
    { label: 'YouTube', url: s.social?.youtube ?? '' },
    { label: 'Stickers', url: s.social?.stickers ?? '' },
  ]
).filter((b) => b && b.label && b.url);
const featuredId = extractYoutubeId(s.featuredYoutube) ?? extractYoutubeId(s.featuredYoutubeId);
const embedSrc = featuredId ? youtubeEmbedUrl(featuredId) : null;
---

<BaseLayout current="home">
  <section class="video-block" aria-labelledby="featured-title">
    {embedSrc && (
    <div class="video-frame">
      <iframe
        src={embedSrc}
        title={settings.featuredVideoTitle}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
    )}
    <p id="featured-title" class="video-caption">{settings.featuredVideoTitle}</p>
    <p class="tagline">{settings.tagline}</p>
  </section>

  {buttons.length > 0 && (
    <div class="cta-row">
      {buttons.map((b) =>
        b.newTab === false ? (
          <a class="outlined-btn" href={b.url}>{b.label}</a>
        ) : (
          <a class="outlined-btn" href={b.url} target="_blank" rel="noopener noreferrer">{b.label}</a>
        )
      )}
    </div>
  )}
</BaseLayout>
