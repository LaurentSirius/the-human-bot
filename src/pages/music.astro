---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { youtubeEmbedUrl, youtubeWatchUrl } from '../lib/youtube';

// Featured first, then "order" (small = top), then most recent date.
const releases = (await getCollection('releases')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    (a.data.order ?? 0) - (b.data.order ?? 0) ||
    (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
---

<BaseLayout title="Music" current="music" description="Releases & videos — The Human Bot">
  <h2 class="page-heading">Music</h2>
  <div class="list">
    {
      releases.map((release) => {
        const embedSrc = youtubeEmbedUrl(release.data.youtubeId);
        const watchUrl = youtubeWatchUrl(release.data.youtubeId);
        return (
          <article class="card">
            <h2>{release.data.title}</h2>
            {release.data.description && <p>{release.data.description}</p>}
            <div class="video-frame">
              <iframe
                src={embedSrc}
                title={release.data.title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
              />
            </div>
            <p class="meta">
              <a href={watchUrl} target="_blank" rel="noopener noreferrer">
                Watch on YouTube →
              </a>
            </p>
          </article>
        );
      })
    }
  </div>
</BaseLayout>
